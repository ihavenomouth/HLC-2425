---
const { href, title, text, image } = Astro.props;
import { Image } from 'astro:assets';
---

<div class="max-w-sm bg-white border rounded-lg shadow border-slate-200 dark:bg-slate-800 dark:border-slate-700">
    <Image class="rounded-t-lg" src={image}  alt="" />
    <!-- <img class="rounded-t-lg" src={image} alt="" loading="lazy" /> -->
    <div class="p-5">
      <a href={href}>
        <h5 class="mb-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">{title}</h5>
      </a>
      <p class="mb-3 font-normal text-slate-700 dark:text-slate-400">{text}</p>
      <a href={href} class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-green-700 rounded-lg hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
          {title}
           <svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
          </svg>
      </a>
  </div>
</div>